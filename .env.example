MONGODB_URI=mongodb://localhost:27017/ugcad
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Persistent file storage (Cloudinary). Without these, uploads fall back to the
# local disk, which is WIPED on every redeploy on Render. Set on the Render
# service to make creator work files / photos / logos / campaign images durable.
# Either provide the single URL form:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three separate vars:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
